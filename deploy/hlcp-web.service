[Unit]
Description=HLCP Web management UI
After=network.target

[Service]
Type=simple
User=hlcp-web
Group=hlcp-web
WorkingDirectory=/opt/hlcp-web/current/app
ExecStart=/opt/hlcp-web/current/app/Hlcp.Web
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=Hosting__PublicOrigin=https://hlcp.home.goffa.cz
Environment=Storage__Directory=/var/lib/hlcp-web
Environment=Hlcp__Endpoint=http://127.0.0.1:9444
Environment=Hlcp__TokenFile=%d/observer.token
Environment=Dashboard__ApplicationTags__0=kostka
Environment=Dashboard__ApplicationTags__1=medaile
Environment=Dashboard__ApplicationTags__2=infrastructure
LoadCredential=observer.token:/etc/hlcp-web/observer.token
StateDirectory=hlcp-web
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/hlcp-web

[Install]
WantedBy=multi-user.target
