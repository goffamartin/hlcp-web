@inject Hlcp.Web.Services.ResourceActions Actions
@inject AuthenticationStateProvider Authentication
@inject Microsoft.JSInterop.IJSRuntime JavaScript
@using Microsoft.JSInterop
@implements IDisposable

@if (Actions.Enabled)
{
    <div class="flex flex-wrap items-center gap-2">
        <select aria-label="Akce pro @Resource.Id" @bind="selected" disabled="@(Busy || Disabled)" class="max-w-36 rounded border border-slate-300 px-2 py-1 text-xs">
            <option value="">Vyber akci</option>
            @foreach (var action in Resource.Actions.Where(action => action != "logs" || Resource.Type != "container")) { <option value="@action">@action</option> }
        </select>
        <button @ref="opener" type="button" disabled="@(Busy || Disabled || selected.Length == 0)" @onclick="PrepareAsync" class="rounded bg-slate-900 px-3 py-1.5 text-xs font-medium text-white disabled:opacity-40">Provést…</button>
    </div>
}
else { <span class="text-xs text-slate-400">Ovládání není nastavené</span> }
@if (message is not null) { <p role="status" class="mt-2 max-w-xs text-xs leading-5 text-slate-600">@message</p> }
@if (pending is { } operation)
{
        <dialog @ref="dialog" @oncancel="CancelAsync" aria-labelledby="confirm-title" aria-describedby="confirm-description" class="m-auto w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-6 shadow-xl">
            <h2 id="confirm-title" class="text-xl font-semibold">Potvrdit akci @operation.Action?</h2>
            <p id="confirm-description" class="mt-4 text-sm leading-6">Uzel <strong>@operation.Node</strong>, resource <strong>@operation.Resource</strong>. Akce se týká pouze tohoto resource a může ovlivnit jeho provoz.</p>
            <p class="mt-3 break-all font-mono text-xs text-slate-500">ID: @operation.Id</p>
            <div class="mt-6 flex justify-end gap-3">
                <button @ref="cancelButton" type="button" @onclick="CancelAsync" class="rounded-lg border border-slate-300 px-4 py-2 text-sm">Zrušit</button>
                <button type="button" disabled="@Busy" @onclick="ConfirmAsync" class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white disabled:opacity-40">Potvrdit @operation.Action</button>
            </div>
        </dialog>
}

@code {
    [Parameter, EditorRequired] public string Node { get; set; } = "";
    [Parameter, EditorRequired] public ResourceDescriptor Resource { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private bool Busy;
    private string selected = "";
    private string? message;
    private Hlcp.Web.Services.WebOperation? pending;
    private ElementReference opener, cancelButton, dialog;
    private bool focusDialog;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDialog)
        {
            focusDialog = false;
            var module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/dialog.js");
            try { await module.InvokeVoidAsync("show", dialog); await cancelButton.FocusAsync(); }
            finally { await module.DisposeAsync(); }
        }
    }
    private async Task PrepareAsync()
    {
        if (Busy || Disabled || selected.Length == 0) return;
        Busy = true;
        message = null;
        try
        {
            pending = await Actions.PrepareAsync((await Authentication.GetAuthenticationStateAsync()).User, Node, Resource.Id, selected, lifetime.Token);
            focusDialog = true;
        }
        catch (HlcpReadException error) { message = $"Příprava nebyla potvrzena kontrolerem ({error.Failure}). Nic nebylo odesláno k provedení."; }
        catch (IOException) { message = "Operaci nelze bezpečně uložit. Nic nebylo odesláno k provedení."; }
        catch (UnauthorizedAccessException) { message = "Přístup byl odmítnut. Ověř přihlášení a oprávnění místního úložiště webu."; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { Busy = false; }
    }
    private async Task ConfirmAsync()
    {
        if (Busy || pending is null) return;
        Busy = true;
        var operation = pending;
        pending = null;
        try
        {
            var result = await Actions.ConfirmAsync((await Authentication.GetAuthenticationStateAsync()).User, operation.Id, lifetime.Token);
            message = result is null ? $"Výsledek zatím není známý. Dohledání: {operation.Id}." : result.Success ? $"Akce dokončena ({result.Code}). ID: {operation.Id}." : $"Akce skončila chybou ({result.Code}). ID: {operation.Id}.";
        }
        catch (Exception error) when (error is HlcpReadException or IOException or System.Text.Json.JsonException)
        { message = $"Provedení ani výsledek nelze potvrdit. Neopakuj akci; použij dohledání ID {operation.Id} v operacích z webu."; }
        catch (UnauthorizedAccessException) { message = "Přístup byl odmítnut. Ověř přihlášení a místní úložiště; poté zkontroluj operace z webu."; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { Busy = false; }
    }
    private async Task CancelAsync() { if (Busy) return; pending = null; await opener.FocusAsync(); }
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
