@page "/nodes"
@attribute [Authorize(Policy = "Admin")]
@inherits InventoryPageBase

<PageTitle>Uzly | HLCP Web</PageTitle>
<header class="flex flex-wrap items-center justify-between gap-4"><h1 class="text-3xl font-semibold">Uzly</h1><button type="button" disabled="@Loading" @onclick="RefreshAsync" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm disabled:opacity-40">Obnovit</button></header>
<SnapshotNotice State="@State" />
<div class="mt-6 grid gap-4 md:grid-cols-2">
    @foreach (var node in State.Nodes ?? [])
    {
        <article class="rounded-2xl border border-slate-200 bg-white p-6">
            <h2 class="text-lg font-semibold"><a href="@UiLinks.Node(node.NodeId)" class="text-emerald-700 underline">@node.NodeId</a></h2>
            <p class="mt-3 text-sm text-slate-600">@(Stale ? "Zastaralé údaje" : UiLinks.NodeState(node.State)) · @(node.AgentVersion ?? "verze neznámá")</p>
            <p class="mt-2 text-xs text-slate-500">@((node.Inventory.Resources ?? []).Length) dostupných resources</p>
        </article>
    }
</div>
@if (State.Nodes is { Length: 0 }) { <p class="mt-6 text-sm text-slate-500">Žádné dostupné uzly.</p> }
@code { protected override bool LoadAllNodes => true; }
