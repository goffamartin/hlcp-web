<div class="mt-4 overflow-x-auto">
    <table class="w-full text-left text-sm">
        <thead class="border-b border-slate-200 text-xs text-slate-500"><tr><th scope="col" class="px-3 py-3">Resource</th><th scope="col" class="px-3 py-3">Uzel</th><th scope="col" class="px-3 py-3">Stav</th><th scope="col" class="px-3 py-3">Tagy</th><th scope="col" class="px-3 py-3">Ovládání</th></tr></thead>
        <tbody>
            @foreach (var row in Rows.Take(200))
            {
                <tr @key="(row.NodeId, row.Resource.Id)" class="border-b border-slate-100 last:border-0">
                    <th scope="row" class="px-3 py-4 font-medium"><a href="@UiLinks.Resource(row.NodeId, row.Resource.Id)" class="text-emerald-700 underline">@row.Resource.Id</a><span class="block text-xs font-normal text-slate-400">@row.Resource.Type</span></th>
                    <td class="px-3 py-4"><a href="@UiLinks.Node(row.NodeId)" class="text-emerald-700 underline">@row.NodeId</a></td>
                    <td class="px-3 py-4"><span class="rounded-full px-2.5 py-1 text-xs @UiLinks.StateColor(row.State)">@UiLinks.ResourceState(row.State)</span></td>
                    <td class="px-3 py-4 text-xs text-slate-500">@string.Join(", ", row.Resource.Tags ?? [])</td>
                    <td class="min-w-52 px-3 py-4"><ResourceControls Node="@row.NodeId" Resource="@row.Resource" Disabled="@(Stale || row.State == ResourceDisplayState.Stale)" />
                        @if (row.Resource.Type == "container" && row.Resource.Actions.Contains("logs", StringComparer.Ordinal))
                        { <a href="@UiLinks.Logs(row.NodeId, row.Resource.Id)" class="mt-2 inline-block text-xs font-medium text-emerald-700 underline">Logy</a> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Rows.Count > 200) { <p class="mt-3 text-xs text-slate-500">Zobrazeno prvních 200 resources. Zúž výběr pomocí filtrů.</p> }
@code {
    [Parameter, EditorRequired] public IReadOnlyList<ResourceView> Rows { get; set; } = [];
    [Parameter] public bool Stale { get; set; }
}
