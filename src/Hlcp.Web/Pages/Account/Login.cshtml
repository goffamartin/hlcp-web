@page "/account/login"
@model Hlcp.Web.Pages.Account.LoginModel
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Přihlášení | HLCP Web</title>
    <link rel="stylesheet" href="/app.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
    <main class="grid min-h-screen place-items-center p-5">
        <section class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 shadow-sm" aria-labelledby="login-title">
            <p class="text-sm font-semibold text-emerald-700">HLCP Web · místní správa</p>
            <h1 id="login-title" class="mt-3 text-3xl font-semibold tracking-tight">Přihlášení správce</h1>
            <p class="mt-3 text-sm leading-6 text-slate-500">Pro přístup k HomeLabu zadej správcovské heslo.</p>
            @if (Model.Failed)
            {
                <p role="alert" class="mt-5 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800">Přihlášení se nezdařilo. Ověř heslo nebo místní nastavení přístupu.</p>
            }
            <form method="post" class="mt-6">
                <label for="Password" class="block text-sm font-medium">Heslo</label>
                <input id="Password" name="Password" type="password" required maxlength="1024" autocomplete="current-password" autofocus class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 focus:outline-emerald-600" />
                <button type="submit" class="mt-5 w-full rounded-lg bg-emerald-700 px-4 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Přihlásit</button>
            </form>
            <p class="mt-6 text-xs leading-5 text-slate-400">Relace platí nejvýše 8 hodin.</p>
        </section>
    </main>
</body>
</html>
